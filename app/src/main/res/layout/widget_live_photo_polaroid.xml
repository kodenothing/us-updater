<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_live_photo_polaroid"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_live_photo_inner"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/live_photo_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Our Instant shared photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/live_photo_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="Your shared photo will appear here 💜"
            android:textColor="#806C83"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible" />
        <TextView
            android:id="@+id/live_photo_owner_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:padding="5dp"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="2dp"
        android:text="our instant  ♥"
        android:textColor="#594B5D"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
